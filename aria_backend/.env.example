# Copy to .env. Never commit real credentials. Environment values override .env.
# Current Phase 1 HTTPS tunnel origin. Empty permits local startup while Colab is offline.
COLAB_URL=
# Generated by notebook cell 3; sent only as x-api-key to the configured Colab server.
COLAB_API_KEY=
# Development only: permit plain HTTP GPU origins. Leave false for public tunnels.
ALLOW_INSECURE_COLAB=false
# Optional free-tier Groq key. No Groq requests occur with the defaults below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Both true and LOCAL_ONLY=false are needed to enable Groq after dictionary misses.
LLM_TRANSLIT_ENABLED=false
# api_first: Groq handles Roman Urdu first; dictionary/rules remain available on failure.
# dictionary_first: fully recognized sentences use the local dictionary without a call.
TRANSLIT_STRATEGY=dictionary_first
GROQ_MAX_RESPONSE_BYTES=65536
# Retry a cached local fallback after this interval when API-first is enabled.
TRANSLIT_FALLBACK_CACHE_SECONDS=60
# Disables all third-party inference calls except your configured Colab server.
LOCAL_ONLY=true
# Optional local API bearer token; empty disables auth. Use a token before LAN exposure.
ARIA_KEY=
# Enable after setting a random ARIA_KEY of at least 32 characters (private setup does this).
REQUIRE_AUTH=false
# Replace wildcard with explicit hostnames/IPs for your deployment, as private setup does.
ALLOWED_HOSTS=["*"]
# Native Flet needs no browser origins; cross-origin requests are rejected by default.
ALLOWED_ORIGINS=[]
DOCS_ENABLED=false
# Per-client fixed-window admission budget and failed-authentication cap.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_FAILURE_LIMIT=12
# Keep an encrypted copy of the ORIGINAL reference only when explicitly enabled.
KEEP_RAW_AUDIO=false
# off: no checks; basic: optional challenge; strict: every speech response needs a session.
SECURITY_MODE=off
# Assistive communication never requires spoken liveness. Strict checks require research.
WORKFLOW_MODE=assistive
# Normal output is always embedded and validated before caching/playback.
# research_unprotected is accepted only with WORKFLOW_MODE=research.
WATERMARK_POLICY=required
WATERMARK_VERSION=audioseal-v1
# Optional licensed synthetic reference manifest; no default human voice is bundled.
# BUILTIN_VOICE_MANIFEST=C:/private/aria-builtin/manifest.json
ACCOUNT_SESSION_SECONDS=28800
PIN_LOCK_SECONDS=300
PIN_ATTEMPT_LIMIT=5
# Must match the loaded notebook model; change on every model swap and re-enroll voices.
MODEL_VERSION=urdu-xtts-v1
LANG_TAG=ar
# Logical app language -> checkpoint tag. Empty uses {"ur": LANG_TAG}.
# Other languages are discovered from the running notebook's model configuration.
LANGUAGE_ALIASES={}
# Empty DATA_DIR/DICTIONARY_PATH entries should be omitted, not uncommented.
# Defaults are resolved relative to aria_backend, independent of your launch directory.
# DATA_DIR=C:/path/to/aria_backend/data
# DICTIONARY_PATH=C:/path/to/aria_backend/data/roman_urdu_dictionary.json
# Optional Fernet key. Empty creates data/voices/.fernet.key; back it up with the database.
FERNET_KEY=
# Desktop binding. For phone access later, set 0.0.0.0 and configure ARIA_KEY/firewall.
HOST=127.0.0.1
PORT=8001
# Sampling defaults forwarded to Colab; model/voice cache invalidates with temperature changes.
DEFAULT_SPEED=1.0
DEFAULT_TEMPERATURE=0.65
# Text/chunk bounds; chunks never split inside a word. Keep in sync with notebook limits.
CHUNK_MAX_CHARS=180
MAX_TEXT_CHARS=2000
# Maximum simultaneous GPU calls; notebook serializes actual GPU execution.
GPU_CONCURRENCY=2
GPU_TIMEOUT_SECONDS=120
HEALTH_TIMEOUT_SECONDS=5
GPU_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
# Groq makes at most one short retry on 429, then falls back to local rules.
GROQ_TIMEOUT_SECONDS=10
GROQ_BACKOFF_SECONDS=0.3
# Limits apply before upload parsing and while reading GPU responses.
MAX_RESPONSE_BYTES=16777216
MAX_UPLOAD_BYTES=268435456
MAX_REQUEST_BYTES=270532608
MAX_JSON_BYTES=1048576
MAX_PARALLEL_UPLOADS=1
MAX_INFLIGHT=8
BODY_TIMEOUT_SECONDS=300
# Accept long source recordings; select a compact reference for GPU conditioning.
MAX_SOURCE_SECONDS=1800
REFERENCE_SCAN_STEP_SECONDS=5
# Selected reference validation: duration, rates, clipping and frame-based silence.
MIN_REFERENCE_SECONDS=6
MAX_REFERENCE_SECONDS=30
MIN_REFERENCE_SR=8000
MAX_REFERENCE_SR=96000
REFERENCE_SAMPLE_RATE=22050
MAX_SILENCE_RATIO=0.6
SILENCE_THRESHOLD=0.01
MAX_CLIPPING_RATIO=0.01
# Final WAV output and RMS loudness normalization (peak limited, not LUFS metering).
OUTPUT_SAMPLE_RATE=24000
SILENCE_MS=150
TARGET_DBFS=-20
MAX_GENERATED_SECONDS=600
# Bounded encrypted caches. AUDIO_CACHE_ENTRIES=0 disables new audio cache writes.
AUDIO_CACHE_ENTRIES=100
TRANSLIT_CACHE_ENTRIES=5000
# Phase 4: seed once; editing this path does not overwrite an existing phrase bank.
# PHRASE_SEED_PATH=C:/path/to/aria_backend/data/default_phrases.json
PHRASE_MAX_COUNT=500
# Batches translate up to 30 phrase meanings per Groq request; results are encrypted and cached.
PHRASE_TRANSLATION_TIMEOUT_SECONDS=30
# Prepare all phrases for compatible voices at DEFAULT_SPEED on startup/enrollment/edit.
PHRASE_PREWARM_ENABLED=true
# Retry after the user's Colab is unavailable; never calls Groq.
PHRASE_WARM_RETRY_SECONDS=30
# Bounded encrypted history used to train the local Roman Urdu trigram predictor.
PREDICTION_HISTORY_LIMIT=1000
# Optional evaluation script only. Use local paths in LOCAL_ONLY mode.
EVAL_WHISPER_MODEL=small
EVAL_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
# EVAL_MODEL_CACHE=C:/path/to/aria_backend/data/eval_models
# Whisper recognizes Urdu with ur; ar is only the special XTTS training tag.
EVAL_ASR_LANGUAGE=ur
# Optional short-lived strict-mode session token for evaluate.py only; never commit a value.
LIVENESS_SESSION_TOKEN=

# Legacy research embedding switch; required policy enforces protection regardless of this flag.
# Requests never download models.
WATERMARK_ENABLED=false
# Default paths are under aria_backend/data/models; uncomment to override with trusted local files.
# WATERMARK_GENERATOR_PATH=C:/path/to/generator_base.pth
# WATERMARK_DETECTOR_PATH=C:/path/to/detector_base.pth
# Public 16-bit marker, not a secret/signature and not proof of ownership.
WATERMARK_MESSAGE_BITS=0100000101010010
WATERMARK_THRESHOLD=0.5
WATERMARK_BIT_THRESHOLD=0.5
WATERMARK_FRAME_THRESHOLD=0.5
WATERMARK_CHUNK_SECONDS=10
WATERMARK_DETECT_MAX_SECONDS=120
WATERMARK_RETRY_SECONDS=60
# Shared CPU thread limit; models are loaded lazily and run on CPU.
SAFETY_CPU_THREADS=2
# SAFETY_CACHE_DIR=C:/path/to/aria_backend/data/models/runtime
# LIVENESS_WHISPER_PATH=C:/path/to/aria_backend/data/models/whisper-small
# LIVENESS_SPEAKER_PATH=C:/path/to/aria_backend/data/models/ecapa
# Change when replacing ECAPA weights; re-enroll verification profiles afterward.
LIVENESS_MODEL_VERSION=ecapa-voxceleb-v1
LIVENESS_LANGUAGE=ur
LIVENESS_BEAM_SIZE=1
LIVENESS_VAD_FILTER=true
LIVENESS_COMPUTE_TYPE=int8
LIVENESS_TRANSCRIPT_THRESHOLD=0.8
LIVENESS_SPEAKER_THRESHOLD=0.65
# Challenges are single-use and expire in at most 60 seconds, including verification time.
LIVENESS_CHALLENGE_SECONDS=60
LIVENESS_SESSION_SECONDS=300
LIVENESS_MAX_PENDING=100
LIVENESS_MIN_SECONDS=1
LIVENESS_MAX_SECONDS=20
# Local lexicon only; selects optional per-voice reference clips and mild sampling changes.
EMOTION_ENABLED=true
EMOTION_SPEED_DELTA=0.05
EMOTION_TEMPERATURE_DELTA=0.03
# Used ONLY by the explicitly invoked prepare_safety_models.py download script.
SAFETY_WHISPER_REPO=Systran/faster-whisper-small
SAFETY_SPEAKER_REPO=speechbrain/spkrec-ecapa-voxceleb
SAFETY_WATERMARK_REPO=facebook/audioseal
