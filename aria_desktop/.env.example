# Local backend origin ONLY. Do not put a Colab URL or key into the app.
ARIA_BACKEND_URL=http://127.0.0.1:8001
# Must match the backend ARIA_KEY, or stay empty when backend authentication is off.
ARIA_KEY=
# Preview waits this many milliseconds after the last keystroke; blur sends immediately.
ARIA_PREVIEW_DELAY_MS=450
# Long utterances contain several sequential GPU batches; adjust for your Colab runtime.
ARIA_REQUEST_TIMEOUT_SECONDS=300
ARIA_CONNECT_TIMEOUT_SECONDS=5
ARIA_MAX_TEXT_CHARS=2000
# Match the backend upload limit; the backend also validates duration and sound quality.
ARIA_MAX_UPLOAD_BYTES=268435456
# Bound incoming WAV memory. Does not change backend synthesis limits.
ARIA_MAX_AUDIO_BYTES=33554432
ARIA_DEFAULT_SPEED=1.0
# Time to wait for the audio control to report that the WAV loaded.
ARIA_AUDIO_LOAD_TIMEOUT_SECONDS=20
# Local suggestions are debounced separately from Urdu transliteration.
ARIA_PREDICT_DELAY_MS=120
# Refresh phrase ready indicators/favorites/recents while the app is idle.
ARIA_PHRASE_REFRESH_SECONDS=10
